  "query": "UPDATE auth_challenges\n               SET attempts = attempts + 1\n               WHERE token_hash = $1 AND purpose = $2 AND expires_at > now() AND attempts < $3\n               RETURNING id,\n                         user_id,\n                         purpose AS \"purpose: AuthChallengePurpose\",\n                         pending_totp_secret,\n                         attempts",
