  "query": "INSERT INTO users (id, security_ref, name, email, password_hash, terms_version, terms_presented_at)\n               VALUES ($1, $2, $3, $4::text::citext, $5, $6, now())\n               ON CONFLICT (email) DO NOTHING\n               RETURNING id,\n                      security_ref,\n                      name,\n                      email::text AS \"email!\",\n                      password_hash,\n                      email_verified_at IS NOT NULL AS \"is_email_verified!\",\n                      mfa_enabled_at IS NOT NULL AS \"is_mfa_enabled!\",\n                      terms_version",
