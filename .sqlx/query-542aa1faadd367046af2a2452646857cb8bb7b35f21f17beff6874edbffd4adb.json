  "query": "SELECT id,\n                      (extract(epoch FROM moved_at) * 1000)::bigint AS \"moved_at_millis!\",\n                      from_list_name,\n                      to_list_name,\n                      reason,\n                      task_title\n               FROM card_moves\n               WHERE card_id = $1 AND ($2::uuid IS NULL OR id < $2)\n               ORDER BY id DESC\n               LIMIT $3",
