{
  "db_name": "PostgreSQL",
  "query": "SELECT tasks.id,\n                      tasks.parent_id,\n                      tasks.position,\n                      tasks.name,\n                      (tasks.completed_at >= coalesce(to_timestamp($2::bigint / 1000.0), '-infinity')) IS TRUE AS \"is_done!\",\n                      tasks.estimate_minutes,\n                      cards.id AS \"card_id?\",\n                      cards.title AS \"card_title?\",\n                      cards.board_id AS \"card_board_id?\",\n                      (SELECT count(*)\n                       FROM calendar_events\n                       WHERE calendar_events.task_id = tasks.id) AS \"tracked_event_count!\"\n               FROM tasks\n               LEFT JOIN cards ON cards.id = tasks.card_id\n               WHERE tasks.group_id = $1\n               ORDER BY tasks.parent_id NULLS FIRST, tasks.position, tasks.id",
