  "query": "SELECT id,\n                      list_id,\n                      position,\n                      title,\n                      notes,\n                      to_char(due_date, 'YYYY-MM-DD') AS due_date,\n                      to_char(due_time, 'HH24:MI') AS due_time,\n                      (SELECT count(*)\n                       FROM calendar_events\n                       WHERE calendar_events.card_id = cards.id) AS \"tracked_event_count!\"\n               FROM cards\n               WHERE id = $1 AND user_id = $2",
