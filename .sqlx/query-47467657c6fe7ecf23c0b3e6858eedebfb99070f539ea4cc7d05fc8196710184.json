  "query": "UPDATE users\n               SET name = coalesce($2, name),\n                   accent_color = coalesce($3, accent_color),\n                   theme = coalesce($4, theme),\n                   updated_at = now()\n               WHERE id = $1\n               RETURNING name,\n                         email::text AS \"email!\",\n                         accent_color AS \"accent_color: AccentColor\",\n                         theme AS \"theme: ThemeMode\"",
