APP_ORIGINS="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"
RUST_LOG="info"

DATABASE_URL="postgres://postgres@localhost:55440/daibx"

TOTP_KEYS="v1:<run: openssl rand -base64 32>"
TOTP_KEY_CURRENT="v1"

# The web app sends this on every API call. Use the same value in its .env.local.
ORIGIN_SECRET="local-origin-secret-shared-with-the-web-dev-server"

SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURITY="plain"
# Mailpit needs no login, so these stay commented out locally.
# To send real mail through Gmail, uncomment them, use an app password, and set
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURITY="starttls"
# SMTP_USERNAME="you@gmail.com"
# SMTP_PASSWORD="<16-character app password>"
MAIL_FROM="DaiBX <no-reply@daibx.test>"

# Web push signing key. Make one with:
# openssl ecparam -name prime256v1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | base64 | tr '+/' '-_' | tr -d '=\n'
VAPID_PRIVATE_KEY="<base64url 32-byte P-256 private key>"
VAPID_SUBJECT="https://dai-bx.vercel.app"
